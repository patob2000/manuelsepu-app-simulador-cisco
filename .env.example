# URL pública del LMS que lanza la app
LMS_URL=https://aula.cliente.com

# Slug exacto con el que el admin registró la app en /admin/apps.
# Si varias tarjetas apuntan a esta misma instancia, sepáralos con comas.
APP_SLUG=simulador-cisco

# Administrador de prueba. Vacías = no existe.
# Usa el mismo correo con que ese administrador entra al LMS.
# Genera la clave con: openssl rand -base64 24
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Carpeta de la base SQLite. En EasyPanel, móntala como volumen en /app/data.
DATA_DIR=./data
PORT=3000
